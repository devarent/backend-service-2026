# Local development defaults only. Copy to .env and change the password if you
# expose these ports beyond localhost. Never commit .env.
DB_NAME=orders
DB_USER=orders
DB_PASSWORD=local_dev_password
DB_POOL_MAX_SIZE=20

# Local Redis has no password by default. Use a managed Redis with TLS/auth in
# production and set REDIS_PASSWORD there.
REDIS_PASSWORD=

APP_CACHE_ENABLED=true
APP_CACHE_REDIS_ENABLED=true
APP_CACHE_TTL=30s
APP_PRICING_TAX_RATE=0.0825
APP_ORDERS_CURRENCY=USD

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
